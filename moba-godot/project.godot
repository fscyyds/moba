; Engine Configuration File.
; Godot version: 4.3+
; Project: MOBA 3v3 2.5D Client

[application]
config/name="MOBA 3v3 2.5D"
config/description="2.5D client for the MOBA 3v3 server-authoritative prototype. Connects to the existing Node.js WebSocket server."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
boot_splash/bg_color=Color(0.101961, 0.101961, 0.101961, 1)

[autoload]
NetworkClient="*res://scripts/network_client.gd"
GameManager="*res://scripts/game_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=landscape

